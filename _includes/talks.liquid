<div class="talks">
  <ul class="list-group list-group-flush">
    {% for talk in site.data.talks %}
    <li class="list-group-item">
      <div class="row g-0">
        <div class="col-2 text-center date-column">
          <span class="badge font-weight-bold text-uppercase align-middle">
            {{ talk.date }}
          </span>
        </div>
        <div class="col-10">
          <div class="talk-content">
            <div class="talk-header">
              <span class="talk-title">{{ talk.title }}</span>
            </div>
            <div class="talk-venue">{{ talk.venue }}</div>
            <div class="talk-links">
              {% if talk.slides %}
                <a href="{{ talk.slides }}" class="btn btn-sm" target="_blank">
                  <i class="fas fa-desktop"></i> Slides
                </a>
              {% endif %}
              {% if talk.video %}
                <a href="{{ talk.video }}" class="btn btn-sm" target="_blank">
                  <i class="fas fa-video"></i> Video
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </li>
    {% endfor %}
  </ul>
</div>

<style>
.talks .list-group-item {
  padding: 1rem 0;
  border: none;
  border-bottom: 1px solid var(--global-divider-color);
}

.talks .list-group-item:last-child {
  border-bottom: none;
}

.talks .date-column {
  min-width: 60px;
  padding: 0;
}

.talks .badge {
  background-color: var(--global-theme-color) !important;
  color: white !important;
  font-size: 0.75rem;
  padding: 4px 8px;
}

.talks .talk-content {
  margin-left: -15px;
}

.talks .talk-header {
  margin-bottom: 0.3rem;
}

.talks .talk-title {
  font-weight: 500;
  color: var(--global-text-color);
  font-size: 1rem;
}

.talks .talk-venue {
  color: var(--global-text-color-light);
  font-style: italic;
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.talks .talk-links {
  margin-top: 0.4rem;
}

.talks .btn {
  padding: 0.2rem 0.6rem;
  font-size: 0.85rem;
  margin-right: 0.5rem;
  color: var(--global-text-color);
  border: 1px solid var(--global-text-color-light);
  border-radius: 4px;
  transition: all 0.15s ease;
}

.talks .btn:hover {
  color: var(--global-theme-color);
  border-color: var(--global-theme-color);
  text-decoration: none;
}

.talks .btn i {
  margin-right: 0.2rem;
}

@media (max-width: 576px) {
  .talks .talk-content {
    margin-left: 0;
  }
  
  .talks .date-column {
    min-width: 70px;
  }
}
</style>